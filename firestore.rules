rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminRequest() {
      return signedIn() &&
        (
          userData(request.auth.uid).admin == true ||
          request.auth.token.email == 'iadejuwon77@gmail.com' ||
          request.auth.token.email == 'onakomayaokiki@gmail.com'
        );
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsExistingResource() {
      return resource.data.ownerId == request.auth.uid ||
        resource.data.uploadedBy == request.auth.uid ||
        resource.data.userId == request.auth.uid;
    }

    function resourceOwnerFieldsUnchanged() {
      return (!('ownerId' in resource.data) || request.resource.data.ownerId == resource.data.ownerId) &&
        (!('uploadedBy' in resource.data) || request.resource.data.uploadedBy == resource.data.uploadedBy) &&
        (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId);
    }

    function pairIdFor(a, b) {
      return a + '_' + b;
    }

    function validPairDoc(id, a, b) {
      return id == pairIdFor(a, b) || id == pairIdFor(b, a);
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userData(uid) {
      return userDoc(uid).data;
    }

    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/blockedUsers/$(pairIdFor(a, b))) ||
        exists(/databases/$(database)/documents/blockedUsers/$(pairIdFor(b, a)));
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friends/$(pairIdFor(a, b))) ||
        exists(/databases/$(database)/documents/friends/$(pairIdFor(b, a)));
    }

    function areFriendsAfter(a, b) {
      return getAfter(/databases/$(database)/documents/friends/$(pairIdFor(a, b))).data.users is list ||
        getAfter(/databases/$(database)/documents/friends/$(pairIdFor(b, a))).data.users is list;
    }

    function hasPendingFriendRequestFor(a, b) {
      return exists(/databases/$(database)/documents/friendRequests/$(pairIdFor(a, b))) &&
        get(/databases/$(database)/documents/friendRequests/$(pairIdFor(a, b))).data.status == 'pending';
    }

    function hasPendingMessageRequestFor(a, b) {
      return exists(/databases/$(database)/documents/messageRequests/$(pairIdFor(a, b))) &&
        get(/databases/$(database)/documents/messageRequests/$(pairIdFor(a, b))).data.status == 'pending';
    }

    function sameSchool(a, b) {
      return userData(a).school != null &&
        userData(a).school != '' &&
        userData(a).school == userData(b).school;
    }

    function sameDepartment(a, b) {
      return sameSchool(a, b) &&
        userData(a).department != null &&
        userData(a).department != '' &&
        userData(a).department == userData(b).department;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupData(groupId) {
      return groupDoc(groupId).data;
    }

    function groupOwner(groupId) {
      return signedIn() && groupData(groupId).ownerId == request.auth.uid;
    }

    function groupAdmin(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).adminIds;
    }

    function groupMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function messageWithinEditWindow(createdAt) {
      return createdAt is timestamp &&
        request.time < createdAt + duration.value(1, 'h');
    }

    function friendRequestAllowed(from, to) {
      let privacy = userData(to).privacy.friendRequests;
      return privacy == null ||
        privacy == 'everyone' ||
        (privacy == 'same_school' && sameSchool(from, to)) ||
        (privacy == 'same_department' && sameDepartment(from, to));
    }

    function messageRequestAllowed(from, to) {
      let privacy = userData(to).privacy.messageRequests;
      return privacy == null ||
        privacy == 'everyone' ||
        (privacy == 'same_school' && sameSchool(from, to)) ||
        (
          privacy == 'friends_of_friends' &&
          request.resource.data.sharedFriendIds is list &&
          request.resource.data.sharedFriendIds.size() > 0 &&
          areFriends(from, request.resource.data.sharedFriendIds[0]) &&
          areFriends(to, request.resource.data.sharedFriendIds[0])
        );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid) && request.resource.data.uid == uid &&
        request.resource.data.premium == false;
      allow update: if isUser(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'premium', 'verified', 'subscriptionProvider', 'subscriptionProductId',
          'subscriptionPlan', 'subscriptionBilling', 'subscriptionAmount',
          'subscriptionStatus', 'subscriptionExpiresAt', 'premiumExpiresAt',
          'subscriptionAutoRenewing', 'streakCount', 'bestStreak', 'streakDates',
          'lastActiveDate', 'lastActiveAt', 'aiTokenBalance', 'streakFreezeBalance',
          'streakFreezeResetAt', 'streakFreezeLastUsedAt'
        ]);
      allow delete: if false;

      match /groups/{groupId} {
        allow read: if isUser(uid);
        allow create: if isUser(uid) &&
          request.resource.data.groupId == groupId &&
          request.resource.data.role in ['owner', 'member', 'moderator'] &&
          request.resource.data.joinedAt == request.time &&
          (
            (request.resource.data.role == 'owner' && groupData(groupId).ownerId == uid) ||
            (request.resource.data.role in ['member', 'moderator'] &&
              getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.uid == uid)
          );
        allow update: if false;
        allow delete: if isUser(uid);
      }

      match /{subPath=**} {
        allow read: if isUser(uid);
        allow write: if isUser(uid) &&
          !subPath.matches('^streakRewards/.*') &&
          !subPath.matches('^streakSpins/.*') &&
          !subPath.matches('^groups/.*');
      }
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        validPairDoc(requestId, request.resource.data.from, request.resource.data.to) &&
        !blockedEitherWay(request.resource.data.from, request.resource.data.to) &&
        !areFriends(request.resource.data.from, request.resource.data.to) &&
        friendRequestAllowed(request.resource.data.from, request.resource.data.to);
      allow update: if signedIn() &&
        resource.data.to == request.auth.uid &&
        request.resource.data.from == resource.data.from &&
        request.resource.data.to == resource.data.to &&
        request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && resource.data.from == request.auth.uid && resource.data.status == 'pending';
    }

    match /friends/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() &&
        request.resource.data.users is list &&
        request.resource.data.users.size() == 2 &&
        request.auth.uid in request.resource.data.users &&
        validPairDoc(friendshipId, request.resource.data.users[0], request.resource.data.users[1]) &&
        !blockedEitherWay(request.resource.data.users[0], request.resource.data.users[1]) &&
        (
          hasPendingFriendRequestFor(request.resource.data.users[0], request.resource.data.users[1]) ||
          hasPendingFriendRequestFor(request.resource.data.users[1], request.resource.data.users[0]) ||
          hasPendingMessageRequestFor(request.resource.data.users[0], request.resource.data.users[1]) ||
          hasPendingMessageRequestFor(request.resource.data.users[1], request.resource.data.users[0])
        );
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    match /messageRequests/{requestId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() &&
        requestId == pairIdFor(request.resource.data.from, request.resource.data.to) &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 500 &&
        !blockedEitherWay(request.resource.data.from, request.resource.data.to) &&
        !areFriends(request.resource.data.from, request.resource.data.to) &&
        messageRequestAllowed(request.resource.data.from, request.resource.data.to);
      allow update: if signedIn() &&
        resource.data.to == request.auth.uid &&
        request.resource.data.from == resource.data.from &&
        request.resource.data.to == resource.data.to &&
        request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    match /blockedUsers/{blockId} {
      allow read: if signedIn() && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if signedIn() &&
        blockId == pairIdFor(request.resource.data.blockerId, request.resource.data.blockedId) &&
        request.resource.data.blockerId == request.auth.uid &&
        request.resource.data.blockedId != request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create, update: if signedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2 &&
        areFriendsAfter(request.resource.data.memberIds[0], request.resource.data.memberIds[1]) &&
        !blockedEitherWay(request.resource.data.memberIds[0], request.resource.data.memberIds[1]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds &&
          areFriends(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds[1]
          ) &&
          !blockedEitherWay(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds[1]
          );
        allow update: if signedIn() &&
          (
            (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
            (resource.data.senderId == request.auth.uid &&
              messageWithinEditWindow(resource.data.createdAt) &&
              request.resource.data.senderId == resource.data.senderId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'attachments', 'deleted', 'deletedAt', 'edited', 'editedAt'
              ]))
          );
        allow delete: if false;
      }
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read, update, delete: if isUser(uid);
      allow create: if signedIn() && (
        request.resource.data.userId == uid ||
        request.resource.data.recipientId == uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.recipientId == request.auth.uid
      );
    }

    match /stickers/{stickerId} {
      allow read: if signedIn() &&
        resource.data.isActive != false &&
        (
          resource.data.ownerId == request.auth.uid ||
          (resource.data.ownerId == null && (resource.data.isPremium != true || userData(request.auth.uid).premium == true)) ||
          isAdminRequest()
        );
      allow write: if false;
    }

    match /stickerPacks/{packId} {
      allow read: if signedIn() &&
        resource.data.isActive != false &&
        (
          resource.data.ownerId == request.auth.uid ||
          (resource.data.ownerId == null && (resource.data.isPremium != true || userData(request.auth.uid).premium == true)) ||
          isAdminRequest()
        );
      allow write: if false;
    }

    match /stickerUploads/{uploadId} {
      allow read, write: if false;
    }

    match /users/{uid}/stickerRecent/{stickerId} {
      allow read, write: if isUser(uid);
    }

    match /users/{uid}/stickerFavorites/{stickerId} {
      allow read, write: if isUser(uid);
    }

    match /users/{uid}/stickerOperations/{operationId} {
      allow read, write: if false;
    }

    match /rewardCoupons/{couponId} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /GPARecords/{recordId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /cgpaTracker/{recordId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /challengeQuestions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminRequest();
    }

    match /challenges/{challengeId} {
      allow read, write: if signedIn();
      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

    match /challengeUsers/{uid} {
      allow read, write: if isUser(uid);

      match /attempts/{attemptId} {
        allow read, write: if isUser(uid);
      }
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminRequest();
    }

    match /universities/{universityId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminRequest();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminRequest();
    }

    match /tutorialUploads/{uid} {
      allow read, write: if isUser(uid);
    }

    match /rateLimits/{uid} {
      allow read, write: if isUser(uid);
    }

    match /promoSpotlights/{promoId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminRequest();
    }

    match /marketingSources/{sourceId} {
      allow read: if signedIn() || resource.data.active == true;
      allow create, update, delete: if isAdminRequest();
    }

    match /promoSpotlightEvents/{eventId} {
      allow create: if signedIn() &&
        request.resource.data.promoId is string &&
        request.resource.data.eventType in ['promo_impression', 'promo_click', 'promo_dismiss'] &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid || request.resource.data.userId == null);
      allow read: if isAdminRequest();
      allow update, delete: if false;
    }

    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if signedIn() &&
        (isAdminRequest() || ownsExistingResource()) &&
        resourceOwnerFieldsUnchanged();
      allow delete: if signedIn() && (isAdminRequest() || ownsExistingResource());
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminRequest();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.description is string &&
        request.resource.data.category in ['Academics', 'Career', 'Health', 'Social', 'Tech', 'Other'] &&
        request.resource.data.privacy in ['public', 'private'] &&
        request.resource.data.allowMemberMessages is bool &&
        request.resource.data.requireApproval is bool &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.adminIds is list &&
        request.resource.data.adminIds.size() == 1 &&
        request.auth.uid in request.resource.data.adminIds &&
        request.resource.data.moderatorIds is list &&
        request.resource.data.moderatorIds.size() == 0 &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 1 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.memberCount == 1 &&
        request.resource.data.postCount == 0 &&
        request.resource.data.mediaCount == 0 &&
        request.resource.data.fileCount == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastActivityAt == request.time;
      allow update: if (groupOwner(groupId) || groupAdmin(groupId)) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if groupOwner(groupId);

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          memberId == request.resource.data.uid &&
          request.resource.data.role in ['owner', 'member', 'moderator'] &&
          request.resource.data.joinedAt == request.time &&
          (
            (memberId == request.auth.uid && groupData(groupId).privacy == 'public' && request.resource.data.role == 'member') ||
            (memberId == request.auth.uid && groupOwner(groupId) && request.resource.data.role == 'owner') ||
            ((groupOwner(groupId) || groupAdmin(groupId)) && request.resource.data.role in ['member', 'moderator'])
          );
        allow update: if (groupOwner(groupId) || groupAdmin(groupId)) ||
          (memberId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'name', 'email']));
        allow delete: if groupOwner(groupId) || groupAdmin(groupId) || memberId == request.auth.uid;
      }

      match /joinRequests/{requesterId} {
        allow read: if signedIn() && (requesterId == request.auth.uid || groupOwner(groupId) || groupAdmin(groupId));
        allow create: if signedIn() &&
          requesterId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.requestedAt == request.time;
        allow update: if groupOwner(groupId) || groupAdmin(groupId);
        allow delete: if requesterId == request.auth.uid || groupOwner(groupId) || groupAdmin(groupId);
      }

      match /messages/{messageId} {
        allow read: if groupMember(groupId);
        allow create: if groupMember(groupId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if signedIn() &&
          resource.data.senderId == request.auth.uid &&
          messageWithinEditWindow(resource.data.createdAt) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'attachments', 'deleted', 'deletedAt', 'edited', 'editedAt'
          ]);
        allow delete: if false;
      }
    }

    match /{collectionId}/{documentId} {
      allow read, write: if signedIn() && !(collectionId in [
        'notes',
        'questions',
        'promoSpotlights',
        'promoSpotlightEvents',
        'groups',
        'stickers',
        'stickerPacks',
        'stickerUploads'
      ]);
    }
  }
}
